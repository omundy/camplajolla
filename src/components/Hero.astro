---
import { Icon } from 'astro-icon'
import * as GLOBALS from '../lib/globals.mjs'
const { src = `${GLOBALS.ASSETS_URL}/img/callan_marching_banner.jpg` } = Astro.props
---


<div class="container-fluid">
    <div class="row">
        <div class="col g-0 w-100 min-height-img" style={`background-image:url(${src})`}></div>
    </div>
</div>

<style lang="scss">
    .min-height-img {
        min-height: 10rem;
        background-position: center;
        background-repeat: no-repeat;
        background-size: cover;
    }
</style>
